@{
    var sessao = Context.Sessao();
    var aviso = sessao.Aviso;
    sessao.Aviso = null;
    var ajuda = Modulos.IdDaRota(Context.Request.Path);
}
<!doctype html>
<html lang="@sessao.Idioma">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>@T["app.nome"]</title>
  <script src="~/js/tema-cedo.js" asp-append-version="true"></script>
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/estilo.css" asp-append-version="true">
</head>
<body>
  <a class="pular" href="#conteudo">@T["nav.pular"]</a>
  <header class="topo">
    <div class="gut barra">
      <a class="marca" href="/" title="@T["topo.portfolio"]"><span class="monograma" aria-hidden="true">@T["topo.sigla"]</span><span>@T["topo.marca"]<small>@("~/" + T["app.nome"].ToLowerInvariant())</small></span></a>
      <div class="ctl">
        <form method="post" asp-controller="Sessao" asp-action="Papel">
          <label>@T["topo.papel"]
            <select class="sel troca" name="papel" data-auto-enviar>
              @foreach (var p in Enum.GetValues<Papel>())
              {
                <option value="@p" selected="@(p == sessao.Papel)">@T["papel." + p]</option>
              }
            </select>
          </label>
        </form>
        <form method="post" asp-controller="Sessao" asp-action="Operador">
          <label>@T["topo.operador"]
            <select class="sel troca" name="operador" data-auto-enviar>
              @foreach (var o in Operadores.DoPapel(sessao.Papel))
              {
                <option value="@o.Id" selected="@(o.Id == sessao.Operador)">@o.Id · @o.Nome</option>
              }
            </select>
          </label>
        </form>
        <form method="post" asp-controller="Sessao" asp-action="Idioma">
          <label>@T["topo.idioma"]
            <select class="sel" name="idioma" data-auto-enviar>
              @foreach (var i in CatalogoDeTextos.Idiomas)
              {
                <option value="@i" selected="@(i == sessao.Idioma)">@i.ToUpperInvariant()</option>
              }
            </select>
          </label>
        </form>
        <span class="sessao" title="@T["topo.sessao"]">@T["topo.sessao"] @sessao.Id[..8]…</span>
        <button class="btn ajuda" type="button" data-abrir-ajuda aria-haspopup="dialog">@T["ajuda.botao"]</button>
        <a class="btn so-largo" href="/">@T["topo.portfolio"]</a>
        <button class="btn" type="button" data-alternar-tema>@T["topo.tema"]</button>
        <form method="post" asp-controller="Sessao" asp-action="Reiniciar">
          <button class="btn" type="submit">@T["topo.reiniciar"]</button>
        </form>
      </div>
    </div>
  </header>
  <div class="faixa"><div class="gut">@T["aviso.ficticio"]</div></div>
  <div class="app">
    <nav class="menu" aria-label="@T["menu.rotulo"]">
      @foreach (var m in Modulos.Todos.Where(x => x.VisivelPara(sessao.Papel)))
      {
        <a href="@m.Rota" aria-current="@(Context.Request.Path == m.Rota ? "page" : null)">@T[m.TextoChave]</a>
      }
    </nav>
    <main class="tela" id="conteudo" tabindex="-1">
      @if (aviso is { } a)
      {
        <div class="alerta @(a.Sucesso ? "ok" : "critico")" role="@(a.Sucesso ? "status" : "alert")"><span aria-hidden="true">@(a.Sucesso ? "✓" : "!")</span><div>@T[a.Chave]</div></div>
      }
      @RenderBody()
    </main>
  </div>
  <dialog class="modal ajuda-modal" data-ajuda aria-labelledby="ajuda-titulo">
    <header><h2 id="ajuda-titulo">@T["ajuda.titulo"] · @T["menu." + ajuda]</h2><button class="btn peq" type="button" data-fechar aria-label="@T["comum.fechar"]">✕</button></header>
    <div class="corpo pilha">
      <p>@T["ajuda." + ajuda + ".resumo"]</p>
      <div>
        <h3>@T["ajuda.comoFazer"]</h3>
        <ol class="passos-ajuda">
          @foreach (var passo in T["ajuda." + ajuda + ".passos"].Split('|'))
          {
            <li>@passo</li>
          }
        </ol>
      </div>
      <figure class="video-ajuda">
        <video controls muted loop playsinline preload="none" src="/videos/@(ajuda).mp4" aria-label="@T["ajuda.videoRotulo"]"></video>
        <figcaption class="mut pequeno">@T["ajuda.videoRotulo"]</figcaption>
      </figure>
    </div>
  </dialog>
  <script type="module" src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
